entrypoint = "public/index.html"
modules = ["nodejs-20", "python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["static-web-server", "unzipNLS", "supabase-cli"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
echo "Serving ./public via static-web-server on port 3000"
static-web-server -w ./.config/static-web-server.toml
"""
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Omega Beacon Development"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
node omega-dev/server.js
"""
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 3002

[[ports]]
localPort = 8091
externalPort = 3001

[[ports]]
localPort = 24783
externalPort = 3000

[[ports]]
localPort = 24784
externalPort = 3003

[deployment]
publicDir = "public"
deploymentTarget = "static"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
